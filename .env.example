# Configuracion local de Blinka (F0/F1). Copiar a .env si se necesita cambiar algo.
# F0/F1 NO requiere credenciales ni llamadas a servicios externos: no pongas secretos aqui.

# Directorio unico desde el que se permite leer facturas sinteticas (relativo a la raiz del repo).
BLINKA_INVOICES_DIR=data/invoices

# Referencias ficticias: policy.json, beneficiaries.json, agreements.json
BLINKA_REFERENCE_DIR=data/reference

# Base SQLite local (excluida de git).
BLINKA_DB_PATH=var/blinka.db
